+# ------------------------------------------------- 6. Guardrail score/threshold scale
+# Regression: `harm_severity` is an ordinal score over 4 anchors (0..3), but the
+# violation test compared it against the same 0.5 threshold used for noul
+# probabilities. Measured against the real checkpoint, ordinary requests score
+# 0.56-1.41 and harmful ones 1.76-2.42, so the default configuration flagged
+# every input. Values below are the measured real-model outputs.
+def measured_guard_response(state, questions):
+    text = str(state).lower()
+    if "ignore all previous" in text:
+        sev, jb, inj = 1.989, 1.0, 1.0
+    elif "synthesize meth" in text:
+        sev, jb, inj = 1.762, 0.0, 0.0
+    elif "reverse a list" in text:
+        sev, jb, inj = 1.412, 0.0, 0.023
+    else:
+        sev, jb, inj = 0.564, 0.0, 0.002
+    return {
+        "model": "measured",
+        "answers": {
+            "jailbreak": {"type": "noul", "noul": jb, "confidence": 0.9},
+            "prompt_injection": {"type": "noul", "noul": inj, "confidence": 0.85},
+            "sensitive_data": {"type": "noul", "noul": 0.0, "confidence": 0.9},
+            "harm_severity": {"type": "score", "score": sev, "confidence": 0.95},
+        },
+    }
 
 
